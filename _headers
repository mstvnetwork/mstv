# ════════════════════════════════════════════════════════
# _headers  (place at repo ROOT)
# Works identically on BOTH Netlify and Cloudflare Pages.
# Same format, same syntax, recognised by both platforms.
# ════════════════════════════════════════════════════════

# Global security headers — every response
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# channels2.json — NEVER cached (enables real-time channel updates)
/channels2.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Access-Control-Allow-Origin: *
  Vary: *

# HTML pages — short cache so deploys propagate fast
/*.html
  Cache-Control: public, max-age=60, must-revalidate

# SEO channel pages
/channels_pages/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Sitemap — revalidate often
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

# Static assets — long cache with immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
