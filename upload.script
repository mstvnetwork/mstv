cat > $HOME/install_upload.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash

pkg update -y
pkg install -y git ffmpeg

cat > $PREFIX/bin/upload << 'SCRIPT'
#!/data/data/com.termux/files/usr/bin/bash

set -e

REPO_DIR="$HOME/mstv11"
CONFIG="$HOME/.mstv11_config"
DOWNLOAD="/storage/emulated/0/Download"

# ================= CLEANUP (SAFE) =================
echo "Cleaning previous processes..."

set +e
pkill -f ffmpeg 2>/dev/null || true

# safely kill other upload instances, not itself
for pid in $(pgrep -f upload); do
    if [ "$pid" != "$$" ]; then
        kill "$pid" 2>/dev/null || true
    fi
done

rm -f "$REPO_DIR/.git/index.lock" 2>/dev/null || true
set -e

# ================= CONFIG =================
if [ ! -f "$CONFIG" ]; then
    echo "GitHub repo URL:"
    read REPO_URL

    echo "GitHub token:"
    read TOKEN

    cat > "$CONFIG" <<CFG
REPO_URL=$REPO_URL
TOKEN=$TOKEN
CFG
fi

source "$CONFIG"

# ================= CLONE =================
if [ ! -d "$REPO_DIR/.git" ]; then
    rm -rf "$REPO_DIR"
    git clone "https://${TOKEN}@${REPO_URL#https://}" "$REPO_DIR"
fi

cd "$REPO_DIR"
touch .uploaded_hashes

# ================= NEXT ID =================
NEXT_ID() {
    ls -1d [0-9]* 2>/dev/null | sort -n | tail -1 | awk '{print $1+1}'
}

# ================= REPO SIZE (FIXED) =================
REPO_STATUS() {
    echo
    echo "===== REPO STATUS ====="

    SIZE_HUMAN=$(git count-objects -vH | awk '/size-pack/ {print $3, $4}')
    echo "Git size: $SIZE_HUMAN"

    SIZE_RAW=$(git count-objects -v | awk '/size-pack/ {print $3}')

    if [ -z "$SIZE_RAW" ]; then
        SIZE_RAW=0
    fi

    if [ "$SIZE_RAW" -ge 900000 ]; then
        echo "CRITICAL: repo near limit"
    elif [ "$SIZE_RAW" -ge 700000 ]; then
        echo "WARNING: repo growing"
    else
        echo "OK: repo healthy"
    fi

    echo "======================="
    echo
}

# ================= MAIN LOOP =================
find "$DOWNLOAD" -type f -iname "*.mp4" | while read FILE
do
    HASH=$(md5sum "$FILE" | awk '{print $1}')

    if grep -q "^$HASH$" .uploaded_hashes; then
        echo "SKIP: $(basename "$FILE")"
        continue
    fi

    ID=$(NEXT_ID)
    [ -z "$ID" ] && ID=1

    echo "Processing -> $ID : $(basename "$FILE")"

    mkdir -p "$ID"

    # ================= HLS (NO RE-ENCODE) =================
    ffmpeg -y -i "$FILE" \
        -c copy \
        -hls_time 6 \
        -hls_list_size 0 \
        -f hls \
        "$ID/index.m3u8"

    # mark uploaded
    echo "$HASH" >> .uploaded_hashes

    # ================= SAFE GIT SYNC =================
    git fetch origin main
    git reset --hard origin/main

    git add "$ID"
    git commit -m "video $ID" || true
    git push origin main

    echo
    echo "STREAM:"
    echo "https://cdn.jsdelivr.net/gh/mstvnetwork/mstv11@main/$ID/index.m3u8"
    echo

    REPO_STATUS

done
SCRIPT

chmod +x $PREFIX/bin/upload

echo "Installed. Run: upload"
EOF

bash $HOME/install_upload.sh
